# Node / package managers
**/node_modules/
**/.npm/
**/.pnpm-store/
**/.pnp.*
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# TypeScript / build outputs
**/dist/
**/build/
**/*.tsbuildinfo

# Test coverage
**/coverage/
**/.nyc_output/

# Logs
**/*.log

# Environment variables (keep examples/templates)
**/.env
**/.env.*
!**/.env.example
!**/.env.template

# Tool caches
**/.cache/
**/.eslintcache

# Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
**/*.swp
**/*.swo

